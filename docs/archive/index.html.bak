      <div class="f-dots" id="featuredDots">
        <button class="f-dot active" data-goto="0" aria-label="Ir para o destaque 1"></button>
        <button class="f-dot" data-goto="1" aria-label="Ir para o destaque 2"></button>
        <button class="f-dot" data-goto="2" aria-label="Ir para o destaque 3"></button>
        <button class="f-dot" data-goto="3" aria-label="Ir para o destaque 4"></button>
        <button class="f-dot" data-goto="4" aria-label="Ir para o destaque 5"></button>
        <button class="f-dot" data-goto="5" aria-label="Ir para o destaque 6"></button>
      </div>

    </div>
  </section>

  <!-- O layout antigo da home foi removido. As seções de vídeos dinâmicas são renderizadas abaixo do Destaque. -->
</main>

